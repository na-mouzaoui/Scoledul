<UserControl x:Class="Timetable.Desktop.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>

    <StackPanel>
        <TextBlock Text="Résultats" Style="{StaticResource HeaderText}" />

        <!-- Barre d'outils (revient à la ligne si la fenêtre est étroite) -->
        <WrapPanel Margin="0,0,0,6">
            <TextBlock Text="Vue :" Margin="0,0,6,6" />
            <ComboBox ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" Width="130"
                      Margin="0,0,12,6" />
            <ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}"
                      DisplayMemberPath="Name" Width="180" Margin="0,0,12,6" />
            <Button Content="Annuler" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                    Margin="0,0,8,6" />
            <Button Content="Rétablir" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                    Margin="0,0,8,6" />
            <Button Content="Valider" Command="{Binding ValidateScheduleCommand}"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" />
        </WrapPanel>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Muted}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding VersionName, StringFormat=Version affichée : {0}}"
                   Foreground="{DynamicResource Muted}" Margin="0,0,0,10" />

        <!-- Grille : défilement horizontal et vertical interne, largeur bornée à la fenêtre -->
        <Border Style="{StaticResource Card}" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          MaxHeight="520">
                <ItemsControl ItemsSource="{Binding Rows}" MinWidth="{Binding GridMinWidth}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Header}" Margin="2" FontWeight="SemiBold"
                                           FontSize="10" TextWrapping="Wrap" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border AllowDrop="True" MinHeight="48" Margin="1"
                                                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                                                    MouseMove="Cell_MouseMove"
                                                    MouseLeftButtonDown="Cell_MouseLeftButtonDown"
                                                    DragOver="Cell_DragOver"
                                                    Drop="Cell_Drop"
                                                    ToolTip="{Binding Text}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BreakFill}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PanelAltBackground}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="10"
                                                               Margin="2" VerticalAlignment="Center" />
                                                    <TextBlock Text="🔒" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                               FontSize="10" Margin="2"
                                                               Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Conflits -->
        <TextBlock Text="Conflits" Style="{StaticResource SectionText}" />
        <ListBox ItemsSource="{Binding Conflicts}" MaxHeight="170">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Statistiques par classe -->
        <TextBlock Text="Statistiques par classe" Style="{StaticResource SectionText}" />
        <DataGrid ItemsSource="{Binding ClassStatistics}" AutoGenerateColumns="False" IsReadOnly="True"
                  MaxHeight="230" Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Classe" Binding="{Binding ClassName}" Width="*" />
                <DataGridTextColumn Header="Séances" Binding="{Binding AssignedSessions}" Width="90" />
                <DataGridTextColumn Header="Trous" Binding="{Binding HoleCount}" Width="80" />
                <DataGridTextColumn Header="Remplissage" Binding="{Binding FillRate, StringFormat=P0}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Charge des enseignants -->
        <TextBlock Text="Charge des enseignants" Style="{StaticResource SectionText}" />
        <DataGrid ItemsSource="{Binding TeacherStatistics}" AutoGenerateColumns="False" IsReadOnly="True"
                  MaxHeight="260" Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Enseignant" Binding="{Binding TeacherName}" Width="*" />
                <DataGridTextColumn Header="Séances" Binding="{Binding WeeklySessions}" Width="90" />
                <DataGridTextColumn Header="Trous" Binding="{Binding HoleCount}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
