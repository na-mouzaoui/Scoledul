<UserControl x:Class="Timetable.Desktop.Views.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <StackPanel>
        <TextBlock Text="Classes" Style="{StaticResource HeaderText}" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Nombre de classes à ajouter :" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
            <TextBox Text="{Binding NumberToAdd}" Width="70" />
            <Button Content="Ajouter" Command="{Binding AddClassesCommand}" Style="{StaticResource PrimaryButton}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Classes}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="260"
                                 mah:TextBoxHelper.Watermark="Nom de la classe" />
                        <Button Content="Supprimer"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.RemoveClassCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
