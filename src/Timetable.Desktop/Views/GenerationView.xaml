<UserControl x:Class="Timetable.Desktop.Views.GenerationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Génération" Style="{StaticResource HeaderText}" />

        <TextBlock Text="Rapport de pré-validation" Style="{StaticResource SectionText}" />
        <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,1"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Préférences de génération" Style="{StaticResource SectionText}" />
        <ItemsControl ItemsSource="{Binding Weights}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" Value="{Binding Weight}" />
                        <TextBlock Grid.Column="2" Text="{Binding Weight}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Durée maximale (s) :" />
            <TextBox Text="{Binding MaxTimeSeconds}" Width="60" />
            <TextBlock Text="Graine :" Margin="14,0,0,0" />
            <TextBox Text="{Binding RandomSeed}" Width="70" />
            <CheckBox Content="Un enseignant = une seule classe" IsChecked="{Binding OneClassPerTeacherWeek}"
                      Margin="14,0,0,0" VerticalContentAlignment="Center" />
            <CheckBox Content="Éviter le sport autour des pauses" IsChecked="{Binding AvoidSportAroundBreak}"
                      Margin="14,0,0,0" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Générer l'emploi du temps" Command="{Binding GenerateCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanGenerate}" />
            <Button Content="Annuler" Command="{Binding GenerateCancelCommand}" IsEnabled="{Binding IsRunning}" />
        </StackPanel>

        <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,10,0,0" />
        <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource Muted}" />
        <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SectionText}" TextWrapping="Wrap" />

        <TextBlock Text="Journal" Style="{StaticResource SectionText}" />
        <ListBox ItemsSource="{Binding Log}" Height="160" />
    </StackPanel>
</UserControl>
