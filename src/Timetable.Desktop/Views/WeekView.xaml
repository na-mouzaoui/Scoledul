<UserControl x:Class="Timetable.Desktop.Views.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Semaine" Style="{StaticResource HeaderText}" />

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Durée d'un créneau (min) :" />
            <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SlotDurationMinutes}"
                      Width="80" Margin="6,0,12,0" />
            <TextBlock Text="{Binding TotalSlotCount, StringFormat={}{0} créneaux générés}"
                       Foreground="{DynamicResource Muted}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Mémoriser comme configuration par défaut"
                    Command="{Binding SaveAsDefaultCommand}" />
            <Button Content="Appliquer à tous les projets"
                    Command="{Binding ApplyToAllProjectsCommand}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Days}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4"
                            Padding="8" Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsActive}" Content="{Binding Label}"
                                          Width="110" VerticalContentAlignment="Center" />
                                <TextBlock Text="Début :" />
                                <TextBox Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="70" />
                                <TextBlock Text="Fin :" />
                                <TextBox Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="70" />
                                <Button Content="+ Pause"
                                        Command="{Binding DataContext.AddBreakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Breaks}" Margin="110,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus}" Width="140" />
                                            <TextBox Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="70" />
                                            <TextBox Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="70" />
                                            <Button Content="Supprimer"
                                                    Command="{Binding DataContext.RemoveBreakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Appliquer à tous"
                                                    Command="{Binding DataContext.ApplyBreakToAllDaysCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Aperçu de la grille" Style="{StaticResource SectionText}" />
        <ItemsControl ItemsSource="{Binding Preview}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Margin="0,0,8,8"
                            Padding="6" MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="{Binding DayLabel}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Avertissements" Style="{StaticResource SectionText}" />
        <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
