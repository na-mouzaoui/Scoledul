<mah:MetroWindow x:Class="Timetable.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconpacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:vm="clr-namespace:Timetable.Desktop.ViewModels"
                 xmlns:views="clr-namespace:Timetable.Desktop.Views"
                 Title="Générateur d'emplois du temps"
                 Width="1340" Height="880" MinWidth="1024" MinHeight="680"
                 Background="{DynamicResource AppBackground}"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="13"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 TitleCharacterCasing="Normal"
                 WindowTransitionsEnabled="True"
                 WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectStepViewModel}">
            <views:ProjectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WeekStepViewModel}">
            <views:WeekView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClassesStepViewModel}">
            <views:ClassesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubjectsStepViewModel}">
            <views:SubjectsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TeachersStepViewModel}">
            <views:TeachersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramStepViewModel}">
            <views:ProgramView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GenerationStepViewModel}">
            <views:GenerationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsStepViewModel}">
            <views:ResultsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportsStepViewModel}">
            <views:ExportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsStepViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="Transparent">
            <MenuItem Header="_Fichier">
                <MenuItem Header="Nouveau projet" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="Ouvrir…" Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="Enregistrer" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Enregistrer sous…" Command="{Binding SaveProjectAsCommand}" />
                <MenuItem Header="Dupliquer le projet" Command="{Binding DuplicateProjectCommand}" />
                <Separator />
                <MenuItem Header="Quitter" Command="{Binding ExitCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectName, StringFormat=Projet : {0}}" Margin="0,0,16,0" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource Muted}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,14">
                        <iconpacks:PackIconMaterial Kind="Table" Width="24" Height="24"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Accent}" />
                        <TextBlock Text="Emplois du temps" FontWeight="Bold" FontSize="15" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                             BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource NavListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconpacks:PackIconMaterial Kind="{Binding Icon}" Width="20" Height="20"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="14,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="◀ Précédent" Command="{Binding PreviousCommand}"
                            IsEnabled="{Binding CanGoPrevious}" />
                    <Button Content="Suivant ▶" Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Complétez cette étape pour continuer" />
                    <TextBlock Text="{Binding DirtyIndicator}" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="16" ToolTip="Modifications non enregistrées" />
                </StackPanel>

                <Border Style="{StaticResource Card}" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <mah:TransitioningContentControl Content="{Binding SelectedStep}" Transition="Left" />
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
