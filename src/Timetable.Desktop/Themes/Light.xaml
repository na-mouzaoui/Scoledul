<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#FFF4F6F8" />
    <SolidColorBrush x:Key="AppForeground" Color="#FF1F2933" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelAltBackground" Color="#FFF0F3F6" />
    <SolidColorBrush x:Key="AppBorder" Color="#FFCBD2D9" />
    <SolidColorBrush x:Key="Accent" Color="#FF2B6CB0" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Muted" Color="#FF6B7785" />
    <SolidColorBrush x:Key="BreakFill" Color="#FFE3E6E9" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC0392B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB7791F" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF2B6CB0" />

</ResourceDictionary>
