<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#FF1B1F23" />
    <SolidColorBrush x:Key="AppForeground" Color="#FFEDEFF2" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FF23272B" />
    <SolidColorBrush x:Key="PanelAltBackground" Color="#FF2C3136" />
    <SolidColorBrush x:Key="AppBorder" Color="#FF3C4349" />
    <SolidColorBrush x:Key="Accent" Color="#FF63A0D6" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FF10161B" />
    <SolidColorBrush x:Key="Muted" Color="#FF9AA4AE" />
    <SolidColorBrush x:Key="BreakFill" Color="#FF3A4046" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFEB7B6B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE3B341" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF7BB3E8" />

</ResourceDictionary>
